# Proposed configuration contract; application/CLI implementation is still pending.
# Copy to a local gitignored file. Supply actual credentials only there.
AFYA_HOST=127.0.0.1
AFYA_PORT=8010
AFYA_STATE_DIR=
AFYA_DATA_MODE=fixture
AFYA_MODEL_MODE=scripted
AFYA_MEMORY_MODE=disabled_fixture
AFYA_DATASET_ID=
AFYA_MAX_ACTIVE_RUNS=1
AFYA_MAX_MODEL_CALLS=4
AFYA_MAX_TOOL_CALLS=10
AFYA_RUN_DEADLINE_SECONDS=600
AFYA_SOURCE_ROW_CAP=2000

ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# Absolute path to the supplied ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_JDBC_JAR=
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=
ZETARIS_PROBE_TABLE=

# Verify this URL from the Ubuntu process; no endpoint is assumed here.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Optional verified Runtime provider. Its token must be real, never rt-local.
METERLESS_RUNTIME_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_RUNTIME_MODEL=

# Pin the actual upstream reference when implementing the bridge.
METERLESS_HMEM_COMMIT=1742dec56a66e58eef9dda2d2b865823758ca8cd
